@startuml ExtensionArchitecture
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

' --- Legend via stereotypes / colors ---
skinparam component {
  BackgroundColor<<Preview>> #E8F5E9
  BackgroundColor<<Renderer>> #FFF9C4
  BackgroundColor<<Mapper>> #FFCDD2
  BackgroundColor<<Extension>> #BBDEFB
}

actor User

package "VS Code Extension Host" {
  [extension.ts\n(Activation)] <<Extension>>

  [PlantUMLPreviewProvider\npreviewProvider.ts] <<Preview>>
  [PlantUMLRenderer\nplantumlRenderer.ts] <<Renderer>>
  [LineMapper\nlineMapper.ts] <<Mapper>>

  interface "VS Code API\n(Workspace, Commands)" as VSCodeAPI
  interface "Webview Panel\n(HTML/SVG Display)" as Webview
}

package "External Processes" {
  [Java Runtime\n(External Command)] as JavaProc
  [PlantUML JAR\nplantuml-1.2025.10.jar] as PlantUMLJar
}

package "User Actions" {
  usecase "Open .puml File" as UC_Open
  usecase "Run Open Preview Command" as UC_Cmd
  usecase "Click Entity in Preview" as UC_Click
  usecase "Select Entities\n(Click/Shift+Drag)" as UC_Select
  usecase "Create Journey\n(Ctrl+Click)" as UC_Journey
}

' --- Entry & commands ---
User --> UC_Open
User --> UC_Cmd
User --> UC_Click
User --> UC_Select
User --> UC_Journey

UC_Open --> [extension.ts\n(Activation)]
UC_Cmd  --> [extension.ts\n(Activation)]

[extension.ts\n(Activation)] --> [PlantUMLPreviewProvider\npreviewProvider.ts] : registerCustomEditorProvider()
[extension.ts\n(Activation)] --> VSCodeAPI : registerCommand('plantuml.openPreview')
[extension.ts\n(Activation)] --> [PlantUMLRenderer\nplantumlRenderer.ts] : downloadJarFile()\n(if needed)

' --- Preview flows ---
UC_Open --> [PlantUMLPreviewProvider\npreviewProvider.ts] : resolveCustomTextEditor()
UC_Cmd  --> [PlantUMLPreviewProvider\npreviewProvider.ts] : open preview

[PlantUMLPreviewProvider\npreviewProvider.ts] --> [PlantUMLRenderer\nplantumlRenderer.ts] : renderFile()
[PlantUMLPreviewProvider\npreviewProvider.ts] --> [LineMapper\nlineMapper.ts] : mapNodesToLines()\nmapEdgesToLines()

[PlantUMLRenderer\nplantumlRenderer.ts] --> JavaProc : exec("java -jar plantuml.jar")
[PlantUMLRenderer\nplantumlRenderer.ts] --> PlantUMLJar : findJarFile()\n(check multiple locations)
[PlantUMLRenderer\nplantumlRenderer.ts] --> VSCodeAPI : checkJavaAvailable()

[LineMapper\nlineMapper.ts] --> VSCodeAPI : openTextDocument()\n(parse .puml file)

[PlantUMLRenderer\nplantumlRenderer.ts] --> [PlantUMLPreviewProvider\npreviewProvider.ts] : RenderResult { svg, error? }
[LineMapper\nlineMapper.ts] --> [PlantUMLPreviewProvider\npreviewProvider.ts] : NodeMapping\nEdgeMapping

[PlantUMLPreviewProvider\npreviewProvider.ts] --> Webview : update HTML/SVG\n(with interactive features)
Webview --> [PlantUMLPreviewProvider\npreviewProvider.ts] : postMessage()\n(copyJourneysToClipboard, reload, error)

UC_Click --> Webview : click entity/edge
UC_Select --> Webview : select entities/edges
UC_Journey --> Webview : create journey entry

VSCodeAPI --> [PlantUMLPreviewProvider\npreviewProvider.ts] : onDidChangeTextDocument
VSCodeAPI --> [PlantUMLPreviewProvider\npreviewProvider.ts] : onDidChange (FileSystemWatcher)

' --- Internal APIs (explicitly annotating key methods) ---
rectangle "PlantUMLRenderer API" #FFF9C4 {
  () "downloadJarFile()" as downloadJar
  () "checkJavaAvailable()" as checkJava
  () "findJarFile()" as findJar
  () "renderFile()" as renderFile
  () "renderToSvg()" as renderToSvg

  [PlantUMLRenderer\nplantumlRenderer.ts] ..> downloadJar
  [PlantUMLRenderer\nplantumlRenderer.ts] ..> checkJava
  [PlantUMLRenderer\nplantumlRenderer.ts] ..> findJar
  [PlantUMLRenderer\nplantumlRenderer.ts] ..> renderFile
  [PlantUMLRenderer\nplantumlRenderer.ts] ..> renderToSvg
}

rectangle "LineMapper API" #FFCDD2 {
  () "mapNodesToLines()" as mapNodes
  () "mapEdgesToLines()" as mapEdges

  [LineMapper\nlineMapper.ts] ..> mapNodes
  [LineMapper\nlineMapper.ts] ..> mapEdges
}

rectangle "PreviewProvider API" #E8F5E9 {
  () "resolveCustomTextEditor()" as resolveEditor
  () "updatePreview()" as updatePreview
  () "getWebviewContent()" as getContent
  () "getErrorHtml()" as getError

  [PlantUMLPreviewProvider\npreviewProvider.ts] ..> resolveEditor
  [PlantUMLPreviewProvider\npreviewProvider.ts] ..> updatePreview
  [PlantUMLPreviewProvider\npreviewProvider.ts] ..> getContent
  [PlantUMLPreviewProvider\npreviewProvider.ts] ..> getError
}

note right of Webview
  Interactive Features:
  - Zoom & Pan
  - Entity & Edge Selection
  - Journey Tracking
  - Source Code View Toggle
end note

note right of PlantUMLJar
  JAR File Locations:
  1. Extension directory
  2. Global storage
  3. Workspace root
  4. Current working directory
end note

@enduml
