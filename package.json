{
  "name": "graphviz-preview",
  "displayName": "Graphviz Preview",
  "description": "Interactive preview for Graphviz (.dot) files with click-to-select navigation and MCP server support",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:dot",
    "onCommand:graphviz.openPreview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dot",
        "aliases": [
          "Graphviz",
          "dot"
        ],
        "extensions": [
          ".dot",
          ".gv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "graphviz.openPreview",
        "title": "Open Graphviz Preview",
        "category": "Graphviz"
      }
    ],
    "customEditors": [
      {
        "viewType": "graphviz.preview",
        "displayName": "Graphviz Preview",
        "selector": [
          {
            "filenamePattern": "*.dot"
          },
          {
            "filenamePattern": "*.gv"
          }
        ],
        "priority": "default"
      }
    ],
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}

