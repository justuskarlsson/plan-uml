{
  "name": "plan-uml",
  "displayName": "Plan UML",
  "description": "Interactive preview for PlantUML (.puml) files with click-to-select navigation, zoom controls, and entity mapping",
  "version": "0.0.8",
  "publisher": "justuskarlsson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justuskarlsson/plan-uml.git"
  },
  "homepage": "https://github.com/justuskarlsson/plan-uml#readme",
  "keywords": [
    "plantuml",
    "puml",
    "uml",
    "diagram",
    "preview",
    "visualization",
    "design"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "puml"
        ],
        "extensions": [
          ".puml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "planuml.openPreview",
        "title": "Open Plan UML Preview",
        "category": "Plan UML"
      },
      {
        "command": "planuml.closePreview",
        "title": "Close All Previews",
        "category": "Plan UML"
      },
      {
        "command": "planuml.reloadWebviews",
        "title": "Reload All Previews",
        "category": "Plan UML"
      },
      {
        "command": "planuml.writeCursorRules",
        "title": "Write plan-uml cursor rules",
        "category": "Plan UML"
      }
    ],
    "customEditors": [
      {
        "viewType": "planuml.preview",
        "displayName": "Plan UML Preview",
        "selector": [
          {
            "filenamePattern": "*.puml"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run copy-resources",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "copy-resources": "node -e \"require('fs').mkdirSync('resources', {recursive: true}); require('fs').copyFileSync('.cursor/rules/plan-uml.mdc', 'resources/plan-uml.mdc')\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  }
}