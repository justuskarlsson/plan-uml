{
  "name": "plantuml-preview",
  "displayName": "PlantUML Preview",
  "description": "Interactive preview for PlantUML (.puml) files with click-to-select navigation",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "puml"
        ],
        "extensions": [
          ".puml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "plantuml.openPreview",
        "title": "Open PlantUML Preview",
        "category": "PlantUML"
      }
    ],
    "customEditors": [
      {
        "viewType": "plantuml.preview",
        "displayName": "PlantUML Preview",
        "selector": [
          {
            "filenamePattern": "*.puml"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  }
}